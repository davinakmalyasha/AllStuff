# API runtime (services/api)
#
# This file is a REFERENCE, not something the API loads. There is no dotenv
# dependency and config.Load() reads os.Getenv only, so `cp .env.example .env`
# followed by `go run ./cmd/api` runs on the built-in defaults and quietly
# ignores everything you just wrote. Export the variables, or use your shell's
# env-file support:
#
#   bash/zsh:  set -a; . ./.env; set +a
#   PowerShell: Get-Content .env | Where-Object { $_ -match '^[^#]' } |
#                 ForEach-Object { $n, $v = $_ -split '=', 2; Set-Item env:$n $v }
#
# Every name below is read by services/api/internal/config/config.go. That file
# is the source of truth; this one is the documented subset worth copying.
PORT=8080
APP_ENV=dev
PUBLIC_URL=http://localhost:5173
# PROD HARD REQUIREMENT: config.Validate rejects a DATABASE_URL whose sslmode is
# not require/verify-full, so a copy of this dev line will not boot in prod.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/bizverse?sslmode=disable
# REQUIRED in prod. Must be >= 32 chars of high-entropy material, and must not
# look like a placeholder — startup fails on anything that does.
# Generate: openssl rand -hex 32
# NOTE: deliberately shipped EMPTY. A copy-paste of a literal here previously
# produced a bootable prod config signed with a publicly-known key.
JWT_SECRET=
MIGRATIONS_DIR=../../infra/postgres/migrations
# REQUIRED in prod (hard error, not a warning): without it session cookies are
# sent over plaintext HTTP.
COOKIE_SECURE=false
CORS_ORIGINS=http://localhost:5173
# Extra allowed WebSocket origins (comma-separated). Same-origin + CORS origins always allowed.
WS_ORIGINS=
# Set true ONLY behind a proxy that strips inbound X-Forwarded-For.
# PRODUCTION (Vercel -> Railway) REQUIRES THIS: with it false, clientIP() returns
# the proxy egress IP for every user, so the 5/min login and 3/15min 2FA buckets
# collapse into ONE global bucket and a single attacker triggers a platform-wide
# 2FA lockout.
TRUST_X_FORWARDED_FOR=false
# Log verbosity: debug | info | warn | error.
LOG_LEVEL=info

# Default per-IP request budget for everything that has no more specific tier:
# 120 requests/minute. A BARE INTEGER — "120/min" is rejected and the default is
# used, so a doc that shows the unit here is wrong and silently inert.
#
# Raise this behind a corporate NAT or a proxy where many real users share one
# egress IP. Do NOT raise it to work around a 429 on the auth or 2FA tiers: those
# are separate, per-account buckets and are the ones an attacker would target.
RATELIMIT_GLOBAL=120

# Directory the built web app is served from by the API's SSR endpoints
# (/ssr/b/{slug}, /ssr/c/{slug}, /ssr/city/{slug}).
#
# Set this in a single-container deployment. The SSR renderer reads
# .vite/manifest.json from this directory to reference the hashed JS and CSS, and
# a missing manifest degrades to a crawlable-but-unhydrated page rather than an
# error. Leave EMPTY when the frontend is served separately (the Vercel setup),
# in which case Vite emits the manifest during `vercel build` and the SSR shell
# falls back to document-only output.
WEB_DIST_DIR=

# Bearer token protecting GET /metrics when set. Set it in prod so your Prometheus
# scraper can pull metrics via Authorization: Bearer <token>.
METRICS_TOKEN=

# Multi-instance WS fan-out. Empty = single instance. Use rediss:// for TLS.
# The dev compose Redis requires a password: redis://:bizverse@localhost:6379
REDIS_URL=

# Stripe (Phase 7.1 monetization). Leave empty for local work: the free plan
# still resolves and /pricing renders, only checkout/portal/webhook are
# unavailable. PROD: if STRIPE_SECRET_KEY is set, STRIPE_WEBHOOK_SECRET is a
# hard requirement — without it no subscription change is ever applied.
#
# Before a paid plan can be sold, bind its Stripe price id:
#   UPDATE plans SET stripe_price_id = 'price_...' WHERE id = 'growth';
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Safe to expose to the browser (VITE_STRIPE_PUBLISHABLE_KEY on the frontend).
STRIPE_PUBLISHABLE_KEY=

# Media storage. MEDIA_DIR is relative to the API working directory.
MEDIA_DIR=./data/media
MEDIA_BASE=http://localhost:8080/api/v1/media

# Email. Leave RESEND_API_KEY empty to log emails to the API console in dev,
# or set SMTP_ADDR to relay through local SMTP (e.g. Mailpit at localhost:1025).
#
# Note the variable name: it is SMTPPASS, not SMTP_PASS. The earlier name in this
# file was not what config.go reads, so SMTP auth was silently always empty.
RESEND_API_KEY=
EMAIL_FROM=no-reply@bizverse.app
SMTP_ADDR=
SMTP_USER=
SMTPPASS=

# Google OAuth (disabled when empty). Callback: {PUBLIC_URL}/auth/oauth/google/callback
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Web Push VAPID keys — generate with: go run ./cmd/api -vapid
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Verification-document encryption (32-byte key = 64 hex chars). REQUIRED in prod:
# startup fails without it (documents would otherwise sit on disk unencrypted).
# Generate: openssl rand -hex 32
MEDIA_ENCRYPTION_KEY=

# ClamAV virus scanning of uploads (clamd host:port, e.g. localhost:3310). REQUIRED in prod;
# uploads FAIL CLOSED while the scanner is unreachable. Empty = disabled (dev only).
CLAMAV_ADDR=
