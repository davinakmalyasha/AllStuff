# API runtime (services/api)
PORT=8080
APP_ENV=dev
PUBLIC_URL=http://localhost:5173
DATABASE_URL=postgres://postgres:postgres@localhost:5432/bizverse?sslmode=disable
JWT_SECRET=change-me-to-a-random-64-char-secret
MIGRATIONS_DIR=../../infra/postgres/migrations
COOKIE_SECURE=false
CORS_ORIGINS=http://localhost:5173

# Email (Resend). Leave empty to log emails to the API console in dev.
RESEND_API_KEY=
EMAIL_FROM=no-reply@bizverse.app
