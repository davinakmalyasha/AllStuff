{
  "rewrites": [
    { "source": "/api/:path*", "destination": "https://bizverse-api.up.railway.app/api/:path*" },
    { "source": "/og/:path*", "destination": "https://bizverse-api.up.railway.app/og/:path*" },
    { "source": "/robots.txt", "destination": "https://bizverse-api.up.railway.app/robots.txt" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "X-Frame-Options", "value": "DENY" }
      ]
    }
  ]
}
